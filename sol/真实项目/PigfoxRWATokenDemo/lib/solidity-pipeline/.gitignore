# Secrets. This repo has no deployment role and should never hold key material,
# but the ignore is written before anything else so there is no window in which
# an .env could exist untracked-but-uncovered.
.env
.env.*
!.env.example

# Scratch produced by the script self-tests.
/tmp-selftest/

# Foundry build output. The project exists only to prove src/ compiles.
out/
cache/

# Claude Code local settings
.claude/settings.local.json

# Session tag (convention v1). Local to the working copy, never committed.
.session-tag
